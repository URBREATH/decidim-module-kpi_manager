<% append_javascript_pack_tag "decidim_kpi_manager_admin" %>

<div class="card mb-4">
  <div class="item_show__header">
    <h2 class="item_show__header-title"><%= t(".featured_title") %></h2>
  </div>

  <% if @selections.empty? %>
    <p class="help-text"><%= t(".empty") %></p>
  <% else %>
    <%# The form itself is the bulk removal (DELETE): Decidim's confirm
        dialog re-submits the form without the clicked button, so that
        action can't rely on the button's own name/value/formaction. The
        refresh button has no confirm, so it overrides method (a later
        _method wins) and action. See admin/bulk_selection.js for the
        select all / enabling logic. %>
    <%= form_tag bulk_destroy_selections_path, method: :delete, data: { kpi_manager_bulk: true } do %>
      <div class="kpi-manager-bulk-actions">
        <%= button_tag type: "submit", name: "_method", value: "patch", formaction: bulk_refresh_selections_path,
                       class: "button button__sm button__secondary", disabled: true,
                       data: { kpi_manager_bulk_action: true } do %>
          <%= icon "refresh-line" %> <span><%= t(".bulk_refresh") %></span> <span data-kpi-manager-bulk-count></span>
        <% end %>
        <%= button_tag type: "submit", class: "button button__sm button__transparent-secondary", disabled: true,
                       data: { kpi_manager_bulk_action: true, confirm: t(".bulk_confirm") } do %>
          <%= icon "delete-bin-line" %> <span><%= t(".bulk_remove") %></span> <span data-kpi-manager-bulk-count></span>
        <% end %>
      </div>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th class="w-8">
              <%= check_box_tag "kpi_manager_select_all", "1", false, id: "kpi-manager-select-all",
                                aria: { label: t(".select_all") }, title: t(".select_all"),
                                data: { kpi_manager_bulk_all: true } %>
            </th>
            <th><%= t(".name") %></th>
            <th><%= t(".value") %></th>
            <th><%= t(".updated") %></th>
            <th class="w-32"><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @selections.each do |selection| %>
            <tr>
              <td>
                <%= check_box_tag "ids[]", selection.id, false, id: "kpi-manager-selection-#{selection.id}",
                                  aria: { label: selection.name }, data: { kpi_manager_bulk_item: true } %>
              </td>
              <td data-label="<%= t(".name") %>">
                <%= selection.name %>
                <% if selection.description.present? %>
                  <br><small class="text-gray-2"><%= truncate(selection.description, length: 120) %></small>
                <% end %>
              </td>
              <td data-label="<%= t(".value") %>"><%= selection.value %> <%= selection.unit %></td>
              <td data-label="<%= t(".updated") %>"><%= selection.recorded_at %></td>
              <td class="table-list__actions" data-label="<%= t(".actions") %>">
                <%= icon_link_to "refresh-line", refresh_selection_path(selection), t(".refresh"), method: :patch %>
                <%= icon_link_to "delete-bin-line", selection_path(selection), t(".remove"), method: :delete, data: { confirm: t(".confirm") } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>
  <% end %>
</div>

<div class="card">
  <div class="item_show__header">
    <h2 class="item_show__header-title"><%= t(".catalog_title") %></h2>
  </div>
  <p class="help-text mb-4"><%= t(".catalog_description") %></p>

  <% if @catalog.blank? %>
    <p class="help-text"><%= t(".catalog_empty") %></p>
  <% else %>
    <%# Each row already has its own "Add" form (button_to), so the bulk form
        can't wrap the table: the checkboxes join it through their `form`
        attribute instead. %>
    <div data-kpi-manager-bulk>
      <%= form_tag selections_path, method: :post, id: "kpi-manager-bulk-add", class: "kpi-manager-bulk-actions" do %>
        <%= button_tag type: "submit", class: "button button__sm button__secondary", disabled: true,
                       data: { kpi_manager_bulk_action: true } do %>
          <%= icon "add-line" %> <span><%= t(".bulk_add") %></span> <span data-kpi-manager-bulk-count></span>
        <% end %>
      <% end %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th class="w-8">
              <%= check_box_tag "kpi_manager_select_all_catalog", "1", false, id: "kpi-manager-select-all-catalog",
                                aria: { label: t(".select_all") }, title: t(".select_all"),
                                data: { kpi_manager_bulk_all: true } %>
            </th>
            <th><%= t(".name") %></th>
            <th><%= t(".value") %></th>
            <th><%= t(".source") %></th>
            <th><%= t(".updated") %></th>
            <th class="w-32"><span class="sr-only"><%= t(".add") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @catalog.each do |item| %>
            <tr>
              <td>
                <%= check_box_tag "items[]", "#{item["type"]}:#{item["id"]}", false, id: "kpi-manager-catalog-#{item["type"]}-#{item["id"]}",
                                  form: "kpi-manager-bulk-add", aria: { label: item["name"] }, data: { kpi_manager_bulk_item: true } %>
              </td>
              <td data-label="<%= t(".name") %>">
                <%= item["name"] %>
                <% if item["description"].present? %>
                  <br><small class="text-gray-2"><%= truncate(item["description"], length: 120) %></small>
                <% end %>
              </td>
              <td data-label="<%= t(".value") %>"><%= item["value"] %> <%= item["unit"] %></td>
              <td data-label="<%= t(".source") %>"><%= item["source"] %></td>
              <td data-label="<%= t(".updated") %>"><%= item["recorded_at"] %></td>
              <td class="table-list__actions" data-label="<%= t(".add") %>">
                <%= button_to t(".add"), selections_path(external_id: item["id"], kind: item["type"]), method: :post, class: "button button__sm button__secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    </div>
  <% end %>
</div>
