<div class="card mb-4">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".featured_title") %></h2>
  </div>
  <div class="card-section">
    <% if @selections.empty? %>
      <p><%= t(".empty") %></p>
    <% else %>
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".value") %></th>
            <th><%= t(".updated") %></th>
            <th><span class="sr-only"><%= t(".actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @selections.each do |selection| %>
            <tr>
              <td><%= selection.name %></td>
              <td><%= selection.value %> <%= selection.unit %></td>
              <td><%= l selection.created_at, format: :decidim_short %></td>
              <td class="table-list__actions">
                <%= icon_link_to "close-line", selection_path(selection), t(".remove"), method: :delete, data: { confirm: t(".confirm") }, class: "action-icon--remove" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-divider">
    <h2 class="card-title"><%= t(".catalog_title") %></h2>
  </div>
  <div class="card-section">
    <p><%= t(".catalog_description") %></p>

    <% if @catalog.blank? %>
      <p><%= t(".catalog_empty") %></p>
    <% else %>
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".value") %></th>
            <th><%= t(".source") %></th>
            <th><span class="sr-only"><%= t(".add") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @catalog.each do |item| %>
            <tr>
              <td><%= item["name"] %></td>
              <td><%= item["value"] %> <%= item["unit"] %></td>
              <td><%= item["source"] %></td>
              <td class="text-right">
                <%= button_to t(".add"), selections_path(external_id: item["id"], kind: item["type"]), method: :post, class: "button tiny" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
