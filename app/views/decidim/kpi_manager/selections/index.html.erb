<%
  add_decidim_page_title(translated_attribute(current_component.name))
  # Inside `render layout: ... do ... end`, implicit `t(".key")` lookups
  # resolve against the *layout*'s path, not this view's, so keys are fully
  # qualified here instead.
  i18n_scope = "decidim.kpi_manager.selections.index"
%>

<%= render layout: "layouts/decidim/shared/layout_center", locals: { columns: 10 } do %>
  <h2 class="h3 mb-4"><%= t("#{i18n_scope}.title") %></h2>
  <p class="text-gray-2 mb-6"><%= t("#{i18n_scope}.description") %></p>

  <% if @selections.empty? %>
    <p class="text-gray-2"><%= t("#{i18n_scope}.empty") %></p>
  <% else %>
    <div class="card__grid-grid">
      <% @selections.each do |selection| %>
        <div class="card__grid kpi-manager-card">
          <div class="card__grid-text">
            <div class="kpi-manager-card__icon">
              <%= icon "bar-chart-2-line", class: "w-5 h-5 text-white fill-current" %>
            </div>
            <h3 class="h4 text-secondary"><%= selection.name %></h3>
            <p class="kpi-manager-card__value">
              <%= selection.value %> <span class="kpi-manager-card__unit"><%= selection.unit %></span>
            </p>
            <div class="card__grid-metadata">
              <% if selection.source.present? %>
                <div><%= icon "map-pin-line" %><%= selection.source %></div>
              <% end %>
              <% if selection.recorded_at.present? %>
                <div><%= icon "calendar-line" %><%= selection.recorded_at %></div>
              <% end %>
            </div>
            <p class="text-sm text-gray-2 mt-2">
              <%= icon "user-line", class: "inline-block" %> <%= t("#{i18n_scope}.featured_by", name: present(selection.author).name) %>
            </p>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
